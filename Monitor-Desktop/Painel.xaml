<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Monitor Desktop" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" SizeToContent="WidthAndHeight" ShowInTaskbar="False" Topmost="True" FontFamily="Segoe UI">
<Window.Resources>
<SolidColorBrush x:Key="Surface" Color="#17202D" />
<SolidColorBrush x:Key="Card" Color="#223044" />
<SolidColorBrush x:Key="Track" Color="#101824" />
<SolidColorBrush x:Key="Text" Color="#F1F5F9" />
<SolidColorBrush x:Key="Muted" Color="#AFC0D5" />
<SolidColorBrush x:Key="Healthy" Color="#4ADE80" />
<SolidColorBrush x:Key="Warning" Color="#FBBF24" />
<SolidColorBrush x:Key="Critical" Color="#FB7185" />
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Text}" /><Setter Property="FontSize" Value="12" /></Style>
<Style TargetType="Button"><Setter Property="Background" Value="#34465F" /><Setter Property="Foreground" Value="{DynamicResource Text}" /><Setter Property="BorderBrush" Value="#4D627C" /><Setter Property="Padding" Value="10,5" /><Setter Property="Margin" Value="3,0" /><Setter Property="Cursor" Value="Hand" /></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource Track}" /><Setter Property="Foreground" Value="{DynamicResource Text}" /><Setter Property="CaretBrush" Value="White" /><Setter Property="BorderBrush" Value="#4D627C" /><Setter Property="Padding" Value="6,4" /><Setter Property="FontSize" Value="12" /></Style>
<Style TargetType="TabItem"><Setter Property="Foreground" Value="#17202D" /><Setter Property="Padding" Value="8,6" /><Setter Property="FontSize" Value="12" /></Style>
<Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#34465F" /><Setter Property="Foreground" Value="{DynamicResource Text}" /><Setter Property="Padding" Value="6" /><Setter Property="BorderThickness" Value="0" /></Style>
<Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="4,0" /></Style>
<Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False" /><Setter Property="IsReadOnly" Value="True" /><Setter Property="CanUserAddRows" Value="False" /><Setter Property="CanUserDeleteRows" Value="False" /><Setter Property="CanUserSortColumns" Value="False" /><Setter Property="HeadersVisibility" Value="Column" /><Setter Property="GridLinesVisibility" Value="None" /><Setter Property="Background" Value="{DynamicResource Track}" /><Setter Property="Foreground" Value="{DynamicResource Text}" /><Setter Property="RowBackground" Value="#223044" /><Setter Property="AlternatingRowBackground" Value="#29384D" /><Setter Property="BorderThickness" Value="0" /><Setter Property="RowHeight" Value="25" /><Setter Property="Height" Value="334" /><Setter Property="SelectionMode" Value="Single" /><Setter Property="FontSize" Value="12" /><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" /><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" /></Style>
<Style x:Key="UrlStatusStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Warning}" /><Style.Triggers><DataTrigger Binding="{Binding Tone}" Value="Healthy"><Setter Property="Foreground" Value="{DynamicResource Healthy}" /></DataTrigger><DataTrigger Binding="{Binding Tone}" Value="Critical"><Setter Property="Foreground" Value="{DynamicResource Critical}" /></DataTrigger></Style.Triggers></Style>
</Window.Resources><Viewbox x:Name="FitBox" Stretch="Uniform" StretchDirection="DownOnly"><Border Width="860" Padding="16" Background="{DynamicResource Surface}" BorderBrush="#40536C" BorderThickness="1" CornerRadius="16"><StackPanel>
<Grid x:Name="Header" Background="Transparent" Cursor="SizeAll" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MONITOR DESKTOP" Foreground="{DynamicResource Muted}" FontSize="10" /><TextBlock Text="Seu computador, em uma visão" FontSize="23" FontWeight="SemiBold" /><TextBlock x:Name="MachineInfo" Text="Conectando aos dados locais..." Foreground="{DynamicResource Muted}" FontSize="11" /></StackPanel><Button x:Name="CloseButton" Grid.Column="1" Content="×" Width="32" Height="32" FontSize="20" VerticalAlignment="Top" ToolTip="Fechar painel" /></Grid>
<TabControl x:Name="Tabs" Background="{DynamicResource Surface}" BorderThickness="0"><TabItem Header="Visão geral"><StackPanel Margin="8"><UniformGrid Columns="3"><Border Background="{DynamicResource Card}" CornerRadius="9" Padding="12" Margin="0,0,7,7" Height="98"><StackPanel><TextBlock Text="CPU" Foreground="{DynamicResource Muted}" FontSize="10" /><TextBlock x:Name="CPUValue" Text="Coletando..." FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" /><TextBlock x:Name="CPUDetail" Text="Aguardando leitura" Foreground="{DynamicResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" /><ProgressBar x:Name="CPUBar" Maximum="100" Height="4" Margin="0,6,0,0" Foreground="{DynamicResource Healthy}" Background="{DynamicResource Track}" BorderThickness="0" Visibility="Hidden" /></StackPanel></Border><Border Background="{DynamicResource Card}" CornerRadius="9" Padding="12" Margin="0,0,7,7" Height="98"><StackPanel><TextBlock Text="MEMÓRIA RAM" Foreground="{DynamicResource Muted}" FontSize="10" /><TextBlock x:Name="RAMValue" Text="Coletando..." FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" /><TextBlock x:Name="RAMDetail" Text="Aguardando leitura" Foreground="{DynamicResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" /><ProgressBar x:Name="RAMBar" Maximum="100" Height="4" Margin="0,6,0,0" Foreground="{DynamicResource Healthy}" Background="{DynamicResource Track}" BorderThickness="0" Visibility="Hidden" /></StackPanel></Border><Border Background="{DynamicResource Card}" CornerRadius="9" Padding="12" Margin="0,0,7,7" Height="98"><StackPanel><TextBlock Text="REDE FÍSICA" Foreground="{DynamicResource Muted}" FontSize="10" /><TextBlock x:Name="NetworkValue" Text="Coletando..." FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" /><TextBlock x:Name="NetworkDetail" Text="Aguardando leitura" Foreground="{DynamicResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" /></StackPanel></Border><Border Background="{DynamicResource Card}" CornerRadius="9" Padding="12" Margin="0,0,7,7" Height="98"><StackPanel><TextBlock Text="LEITURA / GRAVAÇÃO" Foreground="{DynamicResource Muted}" FontSize="10" /><TextBlock x:Name="DiskIOValue" Text="Coletando..." FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" /><TextBlock x:Name="DiskIODetail" Text="Aguardando leitura" Foreground="{DynamicResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" /></StackPanel></Border><Border Background="{DynamicResource Card}" CornerRadius="9" Padding="12" Margin="0,0,7,7" Height="98"><StackPanel><TextBlock Text="GPU" Foreground="{DynamicResource Muted}" FontSize="10" /><TextBlock x:Name="GPUValue" Text="Coletando..." FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" /><TextBlock x:Name="GPUDetail" Text="Aguardando leitura" Foreground="{DynamicResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" /><ProgressBar x:Name="GPUBar" Maximum="100" Height="4" Margin="0,6,0,0" Foreground="{DynamicResource Healthy}" Background="{DynamicResource Track}" BorderThickness="0" Visibility="Hidden" /></StackPanel></Border><Border Background="{DynamicResource Card}" CornerRadius="9" Padding="12" Margin="0,0,7,7" Height="98"><StackPanel><TextBlock Text="TEMPERATURAS" Foreground="{DynamicResource Muted}" FontSize="10" /><TextBlock x:Name="TemperatureValue" Text="Coletando..." FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" /><TextBlock x:Name="TemperatureDetail" Text="Aguardando leitura" Foreground="{DynamicResource Muted}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" /></StackPanel></Border></UniformGrid><TextBlock Text="ARMAZENAMENTO · espaço livre por unidade" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,6,0,8" /><UniformGrid x:Name="DrivesPanel" Columns="3" /><TextBlock x:Name="TopProcesses" Text="Processos: aguardando coleta" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0" /></StackPanel></TabItem><TabItem Header="Processos / PIDs"><StackPanel Margin="8">
<DockPanel Margin="0,0,0,8"><TextBlock Text="Buscar" VerticalAlignment="Center" Margin="0,0,7,0" /><Button x:Name="ProcessesCopy" Content="Copiar PID" DockPanel.Dock="Right" /><ComboBox x:Name="ProcessesSort" Width="125" SelectedIndex="0" Margin="6,0" VerticalContentAlignment="Center"><ComboBoxItem Content="CPU" /><ComboBoxItem Content="RAM" /><ComboBoxItem Content="Nome" /><ComboBoxItem Content="PID" /></ComboBox><TextBox x:Name="ProcessesSearch" ToolTip="Nome, PID ou caminho do executável" /></DockPanel>
<DataGrid x:Name="ProcessesTable"><DataGrid.Columns><DataGridTextColumn Header="Processo" Binding="{Binding Name}" Width="2*" /><DataGridTextColumn Header="PID" Binding="{Binding PID}" Width="65" /><DataGridTextColumn Header="CPU %" Binding="{Binding CPU}" Width="70" /><DataGridTextColumn Header="RAM MiB" Binding="{Binding RAM}" Width="85" /><DataGridTextColumn Header="Executável" Binding="{Binding Path}" Width="3*" /></DataGrid.Columns></DataGrid>
<DockPanel Margin="0,8,0,5"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="ProcessesPrev" Content="Anterior" /><Button x:Name="ProcessesNext" Content="Próxima" /></StackPanel><TextBlock x:Name="ProcessesPage" Text="Coletando..." VerticalAlignment="Center" /></DockPanel>
<TextBox x:Name="ProcessesDetail" IsReadOnly="True" Height="46" TextWrapping="Wrap" Text="Selecione uma linha para ver os detalhes." />
</StackPanel></TabItem><TabItem Header="Conexões"><StackPanel Margin="8">
<DockPanel Margin="0,0,0,8"><TextBlock Text="Buscar" VerticalAlignment="Center" Margin="0,0,7,0" /><Button x:Name="ConnectionsCopy" Content="Copiar PID" DockPanel.Dock="Right" /><TextBox x:Name="ConnectionsSearch" ToolTip="Nome, PID, endereço, porta, TCP, UDP ou estado" /></DockPanel>
<DataGrid x:Name="ConnectionsTable"><DataGrid.Columns><DataGridTextColumn Header="Processo" Binding="{Binding Name}" Width="1.5*" /><DataGridTextColumn Header="PID" Binding="{Binding PID}" Width="60" /><DataGridTextColumn Header="Tipo" Binding="{Binding Protocol}" Width="48" /><DataGridTextColumn Header="Local" Binding="{Binding Local}" Width="2*" /><DataGridTextColumn Header="Destino" Binding="{Binding Remote}" Width="2*" /><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="1.2*" /></DataGrid.Columns></DataGrid>
<DockPanel Margin="0,8,0,5"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="ConnectionsPrev" Content="Anterior" /><Button x:Name="ConnectionsNext" Content="Próxima" /></StackPanel><TextBlock x:Name="ConnectionsPage" Text="Coletando..." VerticalAlignment="Center" /></DockPanel>
<TextBox x:Name="ConnectionsDetail" IsReadOnly="True" Height="46" TextWrapping="Wrap" Text="Selecione uma linha para ver os detalhes." />
</StackPanel></TabItem><TabItem Header="Serviços"><StackPanel Margin="8">
<DockPanel Margin="0,0,0,8"><TextBlock Text="Buscar" VerticalAlignment="Center" Margin="0,0,7,0" /><Button x:Name="ServicesCopy" Content="Copiar PID" DockPanel.Dock="Right" /><TextBox x:Name="ServicesSearch" ToolTip="Nome, descrição, PID ou estado do serviço" /></DockPanel>
<DataGrid x:Name="ServicesTable"><DataGrid.Columns><DataGridTextColumn Header="Serviço" Binding="{Binding Name}" Width="1.5*" /><DataGridTextColumn Header="Descrição" Binding="{Binding Display}" Width="2*" /><DataGridTextColumn Header="PID" Binding="{Binding PID}" Width="60" /><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="90" /><DataGridTextColumn Header="Início" Binding="{Binding Start}" Width="75" /></DataGrid.Columns></DataGrid>
<DockPanel Margin="0,8,0,5"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="ServicesPrev" Content="Anterior" /><Button x:Name="ServicesNext" Content="Próxima" /></StackPanel><TextBlock x:Name="ServicesPage" Text="Coletando..." VerticalAlignment="Center" /></DockPanel>
<TextBox x:Name="ServicesDetail" IsReadOnly="True" Height="46" TextWrapping="Wrap" Text="Selecione uma linha para ver os detalhes." />
</StackPanel></TabItem><TabItem Header="Hardware / Rede"><StackPanel Margin="8"><TextBlock Text="Adaptadores físicos ativos · taxas médias entre coletas" Foreground="{DynamicResource Muted}" Margin="0,0,0,6" /><DataGrid x:Name="AdaptersTable" Height="130"><DataGrid.Columns><DataGridTextColumn Header="Adaptador" Binding="{Binding Name}" Width="2*" /><DataGridTextColumn Header="IPv4" Binding="{Binding IP}" Width="2*" /><DataGridTextColumn Header="Link" Binding="{Binding Link}" Width="*" /><DataGridTextColumn Header="Entrada" Binding="{Binding DownloadText}" Width="*" /><DataGridTextColumn Header="Saída" Binding="{Binding UploadText}" Width="*" /></DataGrid.Columns></DataGrid><DockPanel Margin="0,6,0,0"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="AdaptersPrev" Content="Anterior" /><Button x:Name="AdaptersNext" Content="Próxima" /></StackPanel><TextBlock x:Name="AdaptersPage" VerticalAlignment="Center" /></DockPanel><TextBlock x:Name="GPUInfo" Text="GPU: aguardando leitura" TextWrapping="Wrap" Margin="0,12,0,9" /><TextBlock Text="Sensores de temperatura" Margin="0,0,0,6" /><DataGrid x:Name="SensorsTable" Height="184"><DataGrid.Columns><DataGridTextColumn Header="Hardware" Binding="{Binding Device}" Width="2*" /><DataGridTextColumn Header="Sensor" Binding="{Binding Name}" Width="2*" /><DataGridTextColumn Header="°C" Binding="{Binding Temperature}" Width="65" /><DataGridTextColumn Header="Fonte" Binding="{Binding Source}" Width="1.5*" /></DataGrid.Columns></DataGrid><DockPanel Margin="0,6,0,0"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="SensorsPrev" Content="Anterior" /><Button x:Name="SensorsNext" Content="Próxima" /></StackPanel><TextBlock x:Name="SensorsPage" VerticalAlignment="Center" /></DockPanel><TextBlock x:Name="SensorHelp" Text="Sem sensores? Abra o Libre Hardware Monitor com acesso WMI disponível." Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel></TabItem><TabItem Header="URLs"><StackPanel Margin="8"><TextBlock Text="Uma URL por linha, começando com http:// ou https:// (até 50)." Foreground="{DynamicResource Muted}" Margin="0,0,0,6" /><TextBox x:Name="UrlInput" AcceptsReturn="True" Height="76" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" /><DockPanel Margin="0,8,0,8"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="UrlCheck" Content="Verificar agora" /><Button x:Name="UrlHistoryToggle" Content="Ver histórico" /><Button x:Name="UrlExport" Content="Exportar CSV" /></StackPanel><CheckBox x:Name="UrlAuto" Content="A cada 60 s" Foreground="{DynamicResource Text}" VerticalAlignment="Center" /></DockPanel><DataGrid x:Name="UrlsTable" Height="234"><DataGrid.Columns><DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="3*" /><DataGridTextColumn Header="HTTP" Binding="{Binding Status}" Width="60" ElementStyle="{StaticResource UrlStatusStyle}" /><DataGridTextColumn Header="ms" Binding="{Binding Milliseconds}" Width="65" /><DataGridTextColumn Header="Verificado" Binding="{Binding Checked}" Width="110" /><DataGridTextColumn Header="Detalhes" Binding="{Binding Detail}" Width="2*" /></DataGrid.Columns></DataGrid><DockPanel Margin="0,7,0,5"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="UrlsPrev" Content="Anterior" /><Button x:Name="UrlsNext" Content="Próxima" /></StackPanel><TextBlock x:Name="UrlsPage" VerticalAlignment="Center" /></DockPanel><TextBlock x:Name="UrlStatus" Text="Aguardando sua lista. Nenhuma URL é verificada automaticamente antes de você adicionar endereços." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11" /><TextBox x:Name="UrlsDetail" IsReadOnly="True" Height="38" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel></TabItem></TabControl>
<DockPanel Margin="8,12,8,0"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><RadioButton x:Name="SemiOption" GroupName="Visibility" Content="Semitransparente" Foreground="{DynamicResource Text}" Margin="0,0,12,0" /><RadioButton x:Name="FullOption" GroupName="Visibility" Content="Totalmente visível" Foreground="{DynamicResource Text}" IsChecked="True" /><CheckBox x:Name="PinCheck" Content="Sobre as janelas" Foreground="{DynamicResource Text}" IsChecked="True" Margin="12,0,0,0" /></StackPanel><TextBlock x:Name="Updated" Text="Iniciando coleta..." Foreground="{DynamicResource Muted}" FontSize="10" /></DockPanel><TextBlock x:Name="Notes" Text="" Foreground="{DynamicResource Warning}" FontSize="10" TextWrapping="Wrap" Margin="8,6,8,0" />
</StackPanel></Border></Viewbox></Window>